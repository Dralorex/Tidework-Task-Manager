# Preferred names (use these in Vercel)
TheHollowCrown_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
TheHollowCrown_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Fallbacks still accepted:
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Email (Resend) — verification codes, welcome, password reset
# onboarding@resend.dev can ONLY send to your Resend account email.
# For real users: verify a domain at resend.com/domains and set EMAIL_FROM to it.
RESEND_API_KEY=
EMAIL_FROM="Tidework <onboarding@resend.dev>"
# Public site URL used in email links (optional on Vercel; falls back to VERCEL_URL)
APP_URL="http://localhost:3000"
