# Pooled Neon URL for the app (ends with -pooler in Neon console)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/tidework?sslmode=require"

# Direct Neon URL for Prisma migrations (no -pooler suffix)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/tidework?sslmode=require"
