// Tidework Task Manager — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  CLAIMED
  IN_REVIEW
  DONE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ChatNotifyMode {
  ALL
  MENTIONS
  MUTE
}

enum DmRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?  @unique
  /** Month-day birthday (year ignored). UTC noon on that month/day. */
  birthday     DateTime?
  showBirthdaysOnCalendar Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  ownedWorkspaces       Workspace[]          @relation("WorkspaceOwner")
  memberships           Membership[]
  invitesSent           Invite[]             @relation("InvitesSent")
  assignedTasks         Task[]               @relation("TaskAssignee")
  createdTasks          Task[]               @relation("TaskCreator")
  privateTags           Tag[]                @relation("TagCreator")
  calendarEvents        CalendarEvent[]
  personalCalendarEvents PersonalCalendarEvent[]
  workspaceEventsCreated WorkspaceCalendarEvent[] @relation("WorkspaceEventCreator")
  calendarWorkspaceFilters CalendarWorkspaceFilter[]
  friendshipsRequested  Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived   Friendship[]         @relation("FriendshipAddressee")
  chatMemberships       ChatMember[]
  messages              Message[]
  dmRequestsSent        DmRequest[]          @relation("DmFrom")
  dmRequestsReceived    DmRequest[]          @relation("DmTo")
  notifications         Notification[]
  groupsCreated         ChatGroup[]          @relation("GroupCreator")
  taskActivities        TaskActivity[]       @relation("TaskActivityActor")
  messageMentions       MessageMention[]     @relation("MentionedUser")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /** Soft-delete / archive — null means active */
  archivedAt DateTime?
  archivedById String?
  /** all | roles | members — who (besides Admin+) can still open it */
  archiveVisibility String?
  /** CSV of Role names when visibility=roles */
  archiveVisibilityRoles String?
  /** CSV of user ids when visibility=members */
  archiveVisibilityUserIds String?

  owner       User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  invites     Invite[]
  folders     Folder[]
  tasks       Task[]
  tags        Tag[]
  chatGroups  ChatGroup[]
  calendarEvents WorkspaceCalendarEvent[]
  calendarFilters CalendarWorkspaceFilter[]

  @@index([ownerId])
  @@index([archivedAt])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id              String       @id @default(cuid())
  workspaceId     String
  invitedById     String
  targetUsername  String?
  targetEmail     String?
  role            Role
  status          InviteStatus @default(PENDING)
  token           String       @unique
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([targetUsername])
  @@index([targetEmail])
}

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?
  archivedById String?
  /** all | roles | members */
  archiveVisibility String?
  archiveVisibilityRoles String?
  archiveVisibilityUserIds String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  tasks     Task[]

  @@index([workspaceId])
  @@index([parentId])
  @@index([archivedAt])
}

model Task {
  id                String       @id @default(cuid())
  workspaceId       String
  folderId          String
  name              String
  description       String       @default("")
  priority          TaskPriority @default(MEDIUM)
  dueDate           DateTime?
  status            TaskStatus   @default(OPEN)
  assigneeId        String?
  createdById       String
  completionComment String?
  claimedAt         DateTime?
  /** daily | weekly | monthly — null means one-off */
  recurrenceCadence String?
  /** CSV of weekday ints 0–6 (Sun–Sat) for weekly */
  recurrenceWeekDays String?
  /** CSV of month days 1–31 for monthly */
  recurrenceMonthDays String?
  /** complete | due | both */
  recurrenceSpawnMode String?
  /** same | pool | clear */
  recurrenceNextAssignee String?
  recurrenceSeriesId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         Folder               @relation(fields: [folderId], references: [id], onDelete: Cascade)
  assignee       User?                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User                 @relation("TaskCreator", fields: [createdById], references: [id])
  tags           TaskTag[]
  calendarEvents CalendarEvent[]
  activities     TaskActivity[]
  checklistItems TaskChecklistItem[]

  @@index([workspaceId])
  @@index([folderId])
  @@index([assigneeId])
  @@index([status])
  @@index([recurrenceSeriesId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  type      String
  message   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isPublic    Boolean  @default(true)
  creatorId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("TagCreator", fields: [creatorId], references: [id])
  tasks     TaskTag[]

  @@index([workspaceId])
  @@index([creatorId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  title     String
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, dueDate])
}

/** Freeform events on a user’s private calendar. */
model PersonalCalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/** Freeform events on a workspace calendar (Editor+ can create). */
model WorkspaceCalendarEvent {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  title       String
  description String   @default("")
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, date])
}

/** Which workspaces’ claimed tasks appear on the personal calendar. */
model CalendarWorkspaceFilter {
  userId      String
  workspaceId String
  enabled     Boolean @default(true)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model ChatGroup {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String
  isDirect    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User         @relation("GroupCreator", fields: [createdById], references: [id])
  members   ChatMember[]
  messages  Message[]
  dmRequest DmRequest?

  @@index([workspaceId])
}

model ChatMember {
  id         String         @id @default(cuid())
  groupId    String
  userId     String
  notifyMode ChatNotifyMode @default(ALL)
  lastSeenAt DateTime?
  joinedAt   DateTime       @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model DmRequest {
  id           String         @id @default(cuid())
  fromUserId   String
  toUserId     String
  firstMessage String
  status       DmRequestStatus @default(PENDING)
  chatGroupId  String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromUser  User       @relation("DmFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User       @relation("DmTo", fields: [toUserId], references: [id], onDelete: Cascade)
  chatGroup ChatGroup? @relation(fields: [chatGroupId], references: [id], onDelete: SetNull)

  @@index([toUserId])
  @@index([fromUserId])
}

model Message {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group    ChatGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender   User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mentions MessageMention[]

  @@index([groupId, createdAt])
}

model MessageMention {
  id         String  @id @default(cuid())
  messageId  String
  kind       String
  userId     String?
  roleName   String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation("MentionedUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
