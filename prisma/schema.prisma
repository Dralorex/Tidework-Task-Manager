// Tidework Task Manager — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  CLAIMED
  IN_REVIEW
  DONE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DmRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?  @unique
  nickname     String?
  /** Month-day birthday (year ignored for display). Stored as UTC noon on that month/day in a fixed year. */
  birthday              DateTime?
  shareBirthdayFriends  Boolean  @default(false)
  shareBirthdayWorkspaces Boolean @default(false)
  /** Always prompt before sharing birthday with a new friend/workspace. */
  askBeforeShareBirthday Boolean @default(true)
  showBirthdaysOnCalendar Boolean @default(true)
  /** Soft-delete: username is freed; chats keep history labeled with deletedUsername. */
  deletedAt             DateTime?
  deletedUsername       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  emailVerifications    EmailVerification[]
  ownedWorkspaces       Workspace[]          @relation("WorkspaceOwner")
  memberships           Membership[]
  invitesSent           Invite[]             @relation("InvitesSent")
  assignedTasks         Task[]               @relation("TaskAssignee")
  createdTasks          Task[]               @relation("TaskCreator")
  unclaimedTasks        Task[]               @relation("TaskUnclaimer")
  privateTags           Tag[]                @relation("TagCreator")
  rememberedPrivateTags RememberedPrivateTag[]
  calendarEvents        CalendarEvent[]
  personalEvents        PersonalCalendarEvent[]
  workspaceEventsCreated WorkspaceCalendarEvent[] @relation("WorkspaceEventCreator")
  calendarWorkspaceFilters CalendarWorkspaceFilter[]
  birthdaySharesGiven   BirthdayShare[]      @relation("BirthdayShareOwner")
  birthdaySharesReceived BirthdayShare[]     @relation("BirthdayShareViewer")
  workspaceBirthdayRequests WorkspaceBirthdayRequest[] @relation("BirthdayRequestSubject")
  friendshipsRequested  Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived   Friendship[]         @relation("FriendshipAddressee")
  friendProfilesOwned   FriendProfile[]      @relation("FriendProfileOwner")
  friendProfilesAbout   FriendProfile[]      @relation("FriendProfileSubject")
  chatMemberships       ChatMember[]
  messages              Message[]
  dmRequestsSent        DmRequest[]          @relation("DmFrom")
  dmRequestsReceived    DmRequest[]          @relation("DmTo")
  notifications         Notification[]
  groupsCreated         ChatGroup[]          @relation("GroupCreator")

  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  /** 4-digit email code for website-based password reset. */
  token     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  email      String
  code       String
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([email])
}

/** Signup with email: account is created only after the code is verified. */
model PendingSignup {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String
  code         String
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([email])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  invites     Invite[]
  folders     Folder[]
  tasks       Task[]
  tags        Tag[]
  chatGroups  ChatGroup[]
  calendarEvents WorkspaceCalendarEvent[]
  birthdayRequests WorkspaceBirthdayRequest[]
  calendarFilters CalendarWorkspaceFilter[]

  @@index([ownerId])
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id              String       @id @default(cuid())
  workspaceId     String
  invitedById     String
  targetUsername  String?
  targetEmail     String?
  role            Role
  status          InviteStatus @default(PENDING)
  token           String       @unique
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([targetUsername])
  @@index([targetEmail])
}

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderTree")
  tasks     Task[]

  @@index([workspaceId])
  @@index([parentId])
}

model Task {
  id                String       @id @default(cuid())
  workspaceId       String
  folderId          String
  name              String
  description       String       @default("")
  priority          TaskPriority @default(MEDIUM)
  dueDate           DateTime?
  status            TaskStatus   @default(OPEN)
  assigneeId        String?
  createdById       String
  completionComment String?
  claimedAt         DateTime?
  lastUnclaimReason String?
  lastUnclaimWorkNote String?
  lastUnclaimedById String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         Folder          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User            @relation("TaskCreator", fields: [createdById], references: [id])
  lastUnclaimedBy User?          @relation("TaskUnclaimer", fields: [lastUnclaimedById], references: [id])
  tags           TaskTag[]
  calendarEvents CalendarEvent[]
  rememberedPrivateTags RememberedPrivateTag[]

  @@index([workspaceId])
  @@index([folderId])
  @@index([assigneeId])
  @@index([status])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isPublic    Boolean  @default(true)
  creatorId   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User?     @relation("TagCreator", fields: [creatorId], references: [id])
  tasks     TaskTag[]
  rememberedPrivateTags RememberedPrivateTag[]

  @@index([workspaceId])
  @@index([creatorId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

/** Private tags removed on unclaim and restored if the same user reclaims. */
model RememberedPrivateTag {
  userId String
  taskId String
  tagId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, taskId, tagId])
  @@index([taskId])
}

/** Synced claimed-task due markers on a member’s personal calendar. */
model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  title     String
  dueDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, dueDate])
}

/** Freeform events on a user’s private calendar. */
model PersonalCalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String    @default("")
  date        DateTime
  allDay      Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/** Freeform events on a workspace calendar (Editor+ can create). */
model WorkspaceCalendarEvent {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  title       String
  description String    @default("")
  date        DateTime
  allDay      Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkspaceEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, date])
}

/** Which workspaces’ claimed tasks appear on the personal calendar. */
model CalendarWorkspaceFilter {
  userId      String
  workspaceId String
  enabled     Boolean  @default(true)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

enum BirthdayShareStatus {
  PENDING
  ACTIVE
  DECLINED
  HIDDEN
}

/** Friend can see this user’s birthday on their personal calendar. */
model BirthdayShare {
  id        String              @id @default(cuid())
  ownerId   String
  viewerId  String
  status    BirthdayShareStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  owner  User @relation("BirthdayShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User @relation("BirthdayShareViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@index([viewerId])
}

/** Owner must approve adding a member’s birthday to the workspace calendar. */
model WorkspaceBirthdayRequest {
  id          String              @id @default(cuid())
  workspaceId String
  subjectId   String
  status      BirthdayShareStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject   User      @relation("BirthdayRequestSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subjectId])
  @@index([workspaceId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/** Per-viewer nickname/notes about a friend (directional). */
model FriendProfile {
  id               String   @id @default(cuid())
  ownerId          String
  friendId         String
  personalNickname String?
  personalNotes    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner  User @relation("FriendProfileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("FriendProfileSubject", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([friendId])
}

model ChatGroup {
  id          String    @id @default(cuid())
  workspaceId String?
  name        String
  isDirect    Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  /** Set when either participant closes a DM — viewable but not sendable. */
  closedAt    DateTime?
  closedById  String?

  workspace Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User         @relation("GroupCreator", fields: [createdById], references: [id])
  members   ChatMember[]
  messages  Message[]
  dmRequest DmRequest?

  @@index([workspaceId])
}

model ChatMember {
  id           String   @id @default(cuid())
  groupId      String
  userId       String
  joinedAt     DateTime @default(now())
  /** Heartbeat while the member has this chat open — used to skip noisy notifications. */
  lastActiveAt DateTime?

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model DmRequest {
  id           String         @id @default(cuid())
  fromUserId   String
  toUserId     String
  firstMessage String
  status       DmRequestStatus @default(PENDING)
  chatGroupId  String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromUser  User       @relation("DmFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser    User       @relation("DmTo", fields: [toUserId], references: [id], onDelete: Cascade)
  chatGroup ChatGroup? @relation(fields: [chatGroupId], references: [id], onDelete: SetNull)

  @@index([toUserId])
  @@index([fromUserId])
}

model Message {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
